@model List<AllTrailsAdmin.Models.Trail>

@{
    // The trail object is referred to as "Model"

    ViewData["Title"] = "Trail - All Trails";
}

@foreach(Trail trail in Model)
{
    <h1>@trail.Title</h1>
    <p>@trail.Description</p>
    <hr />
}



