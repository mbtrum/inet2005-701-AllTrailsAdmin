@{
    ViewData["Title"] = "Home Page";

    string name = "Mike";
    string message = "Hello Razor!";

    int count = 10;

    /*List<string> friends = new List<string>();
    friends.Add("Joe");
    friends.Add("Tara"); // bold Tara's name when displaying 
    friends.Add("Nick");*/


    List<Friend> friends = new List<Friend>
    {
        new Friend { Id=1, Name="Joe", Email="joe@email.com" },
        new Friend { Id=2, Name="Tara", Email="tara@email.com" },
        new Friend { Id=3, Name="Nick", Email="nick@email.com"}
    };
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

@{
    // add to message
    message += " This is a message from the code block.";
}

<div class="text-center">
    Hi @name. @message
</div>


<div class="text-center">
    @if(count > 5)
    {
        <p>Count is greater than 5.</p>
    }
    else
    {
        <p>Count is equal to or less than 5.</p>
    }
</div>

<div>
    <ul>
        @foreach(Friend friend in friends)
        {
            if(friend.Name == "Tara")
            {
               <li><strong>@friend.Id @friend.Name @friend.Email</strong></li> 
            }
            else
            {
                <li>@friend.Id @friend.Name @friend.Email</li>
            }
        }
    </ul>
</div>

<div>
    <img src="~/images/capebreton.jpg" alt="Picture of Caoe Breton Highlands" class="picture" />
</div>



